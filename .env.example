# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Any public Sepolia RPC endpoint (Infura/Alchemy/public node) works.
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Testnet-only mnemonic used to deterministically derive wallets.
# This is the well-known public "hardhat/ganache" test mnemonic - replace it
# with your own testnet-only mnemonic. NEVER use a mnemonic that holds real funds.
MNEMONIC=test test test test test test test test test test test junk

# How many wallets to generate/track, 1-20.
WALLET_COUNT=5

# How often to poll on-chain balances, in milliseconds. Must be <= 600000 (10 min).
POLL_INTERVAL_MS=300000

# HTTP port for the API.
PORT=3000
